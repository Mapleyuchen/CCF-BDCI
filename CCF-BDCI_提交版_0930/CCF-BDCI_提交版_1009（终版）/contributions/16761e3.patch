+PROMPT = (
+    "Answer the user's question using the available project facts. "
+    "If the answer is unavailable, say UNKNOWN. Do not call tools."
+)
+MEMORY_SOURCES = (
+    "USER_MEMORY_FILES", "USER_MEMORY_GLOBS",
+    "MANAGED_MEMORY_FILES", "MANAGED_MEMORY_GLOBS",
+)
